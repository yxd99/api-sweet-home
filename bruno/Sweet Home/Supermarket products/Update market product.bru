meta {
  name: Update market product
  type: http
  seq: 2
}

patch {
  url: {{ep}}/supermarket-products/2
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
  	"product_id": 3,
  	"market_id": 4
  }
}

settings {
  encodeUrl: true
  forwardAuthorizationHeader: false
}
