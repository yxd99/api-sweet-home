meta {
  name: Send Code
  type: http
  seq: 2
}

post {
  url: {{ep}}/auth/send-code
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
  	"email": "{{email}}"
  }
}

tests {
  test("Returns 201", function() {
    expect(res.status).to.equal(201);
  });
}

settings {
  encodeUrl: true
  forwardAuthorizationHeader: false
}
