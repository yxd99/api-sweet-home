## Copy this file to `.env` and fill in real values. `.env` is git-ignored.

## GENERAL
# Port the HTTP server listens on.
PORT=3000
# Route prefix. Currently fixed in code (`src/common/constants/api-info.ts`).
PREFIX=api
# development | test | production. `prod` is also accepted. Defaults to
# development. In production the application refuses to boot with a weak JWT
# secret or without the Resend credentials.
ENV=development
# Schema auto-synchronization. When unset it follows ENV: on for development
# and test, off for production. Set it to `true` only if you know what it does.
DB_SYNCHRONIZE=

## DATABASE
DB_HOST=localhost
DB_PORT=3306
DB_NAME=my_home
DB_USER=your-db-user
DB_PASSWORD=your-db-password

## JWT
# At least 32 characters in production. Generate one with: openssl rand -base64 48
JWT_SECRET=replace-me-with-a-random-string-of-at-least-32-characters
JWT_ACCESS_TOKEN_EXPIRY=1h
JWT_REFRESH_TOKEN_EXPIRY=30d

## MAIL (Resend). Required when ENV=production.
RESEND_API_KEY=re_replace_me
RESEND_MAIL_FROM="Sweet Home <no-reply@example.com>"
